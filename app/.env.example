# Copy to `.env` and fill in. `.env` itself is never committed.
#
#   cp .env.example .env
#
# Only `EXPO_PUBLIC_*` variables reach the app, and they are inlined into the
# bundle at build time — anyone with the APK can read them. They are public by
# definition. Never put an API key, token or credential here; those belong on
# the backend.
#
# These are read through `src/config/env.ts`, which is the only place in the
# app allowed to touch `process.env`. Add a new variable there too, or it stays
# untyped and invisible to the rest of the codebase.

# Base URL every request in `src/services/http/client.ts` is prefixed with.
# Falls back to the JSONPlaceholder demo API when unset, so the boilerplate
# boots with no `.env` at all — point it at your own API on day one.
EXPO_PUBLIC_API_URL=https://jsonplaceholder.typicode.com

# development | staging | production — drives `env.isProduction`.
EXPO_PUBLIC_ENV=development

# Spike only (src/features/zoom-spike/): local Node server (../server) that
# issues Zoom session JWTs and receives transcription messages. Use your
# machine's LAN IP, not localhost — the phone is not the same machine.
# Delete this line alongside src/features/zoom-spike/.
EXPO_PUBLIC_SPIKE_SERVER_URL=http://192.168.10.101:3002
