# env — every variant is local, except the committed example.
# `.env*.local` alone is not enough: SETUP.md tells you to create a plain
# `.env`, and that one would have been tracked.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# Scratch output from setup/reset scripts, at the repository root only.
# The leading slash is load-bearing: a bare `example` matches at ANY depth and
# silently swallows `src/features/example/` — the reference feature the docs
# teach from. It did, and every clone was born without it.
/example

# generated mirror of .agents/skills/citi-* (see scripts/check-agent-skills.mjs)
/.claude/skills/citi-*
