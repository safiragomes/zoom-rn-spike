{
  "name": "zoom-rn-spike",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --output-dir dist",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "doctor": "expo-doctor",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "skills:check": "node scripts/check-agent-skills.mjs",
    "skills:sync": "node scripts/check-agent-skills.mjs --sync",
    "test:tooling": "node --test \"tests/tooling/**/*.test.mjs\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tooling && pnpm spec:validate && pnpm skills:check",
    "prepare": "husky && node scripts/check-agent-skills.mjs --sync"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "0.4.1",
    "@expo/metro-runtime": "57.0.16",
    "@zoom/react-native-videosdk": "2.6.1",
    "expo": "57.0.26",
    "expo-asset": "57.0.18",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.9.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.8",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "expo-doctor": "1.20.4",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "react-native-svg-transformer": "1.5.3",
    "tailwindcss": "3.4.17",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@fission-ai/openspec",
      "yarn"
    ]
  }
}
