# React Native assumes a flat node_modules.
#
# pnpm's default isolated layout breaks the resolution of Babel plugins used by
# React Native's Jest preset (@babel/plugin-transform-react-jsx is declared by
# nobody — it is resolved by hoisting), and the same applies to native module
# autolinking and to Metro.
#
# We keep pnpm for the lockfile and the speed, but with a flat layout.
# See docs/architecture/decisions.md (D7).
node-linker=hoisted

# Refuse to install on a Node version outside `engines` instead of warning.
engine-strict=true

# Dependencies allowed to run a build script on install.
only-built-dependencies[]=unrs-resolver

# Denied on purpose: `pnpm.ignoredBuiltDependencies` in package.json lists the
# OpenSpec CLI, whose postinstall only prints a shell-completion tip. pnpm 10
# reads that list from package.json, not from this file.
